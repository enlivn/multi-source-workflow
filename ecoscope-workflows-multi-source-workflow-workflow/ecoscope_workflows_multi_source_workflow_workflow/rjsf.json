{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "Patrols": {
      "type": "object",
      "description": "Choose a data source and patrol types for the patrol track map.",
      "ecoscope:task_group": true,
      "properties": {
        "patrol_source": {
          "additionalProperties": false,
          "properties": {
            "data_source": {
              "$ref": "#/$defs/EarthRangerConnection",
              "title": "",
              "description": "Select one of your configured data sources."
            }
          },
          "required": [
            "data_source"
          ],
          "type": "object",
          "title": "Patrol Data Source"
        },
        "patrol_data": {
          "additionalProperties": false,
          "properties": {
            "patrol_types": {
              "items": {
                "type": "string"
              },
              "title": "Patrol Types",
              "type": "array",
              "description": "Select patrol types to map. Leave empty to analyze all patrol types.",
              "ecoscope:transform": [
                {
                  "transformer": "EarthRangerEnumResolver",
                  "transformer_kws": {
                    "type": "patrol_type",
                    "depends_on": "properties.Patrols.properties.patrol_source.properties.data_source.properties.name"
                  }
                }
              ]
            }
          },
          "required": [
            "patrol_types"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "Events": {
      "type": "object",
      "description": "Choose a data source and event types for the event point map. This source can differ from the patrol source.",
      "ecoscope:task_group": true,
      "properties": {
        "event_source": {
          "additionalProperties": false,
          "properties": {
            "data_source": {
              "$ref": "#/$defs/EarthRangerConnection",
              "title": "",
              "description": "Select one of your configured data sources."
            }
          },
          "required": [
            "data_source"
          ],
          "type": "object",
          "title": "Event Data Source"
        },
        "event_data": {
          "additionalProperties": false,
          "properties": {
            "event_types": {
              "items": {
                "type": "string"
              },
              "title": "Event Types",
              "type": "array",
              "description": "Select event types to map. Leave empty to analyze all event types.",
              "ecoscope:transform": [
                {
                  "transformer": "EarthRangerEnumResolver",
                  "transformer_kws": {
                    "type": "event_type",
                    "depends_on": "properties.Events.properties.event_source.properties.data_source.properties.name"
                  }
                }
              ]
            }
          },
          "required": [
            "event_types"
          ],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "Patrols": {
      "ui:order": [
        "patrol_source",
        "patrol_data"
      ]
    },
    "Events": {
      "ui:order": [
        "event_source",
        "event_data"
      ]
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "Patrols",
      "Events"
    ]
  },
  "additionalProperties": false
}
